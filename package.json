{
  "name": "cloudflare-ai-translator",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted Cloudflare Workers AI translation API compatible with Immersive Translate",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20261110.1-beta",
    "typescript": "^5.9.3",
    "wrangler": "4.160.1"
  }
}
