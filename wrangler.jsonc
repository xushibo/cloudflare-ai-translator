{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-ai-translator",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "ai": { "binding": "AI", "remote": true },
  "vars": {
    "DAILY_NEURON_BUDGET": "9500",
    "CF_ACCOUNT_ID": "00000000000000000000000000000000",
    "API_BASE_PATH": ""
  },
  "secrets": { "required": ["CF_ANALYTICS_TOKEN"] },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "BUDGET_DB",
      "database_name": "translator-budget",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "IP_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }
  ],
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 } }
}
